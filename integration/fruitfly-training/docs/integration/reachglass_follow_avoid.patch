diff --git a/tests/test_follow_avoid.py b/tests/test_follow_avoid.py
new file mode 100644
index 0000000..9496bc2
--- /dev/null
+++ b/tests/test_follow_avoid.py
@@ -0,0 +1,249 @@
+"""follow.avoid step 2: FollowAvoid (brake, sidestep, keep-outs, yaw untouched) and the follow scenarios."""
+
+import math
+
+import pytest
+
+from reachglass.behaviors import Ctx, FollowAvoid, FollowBehind
+from reachglass.behaviors.follow_avoid import Obstacle
+from reachglass.config import load_config
+from reachglass.mapping import Grid
+from reachglass.perception import Perception
+from reachglass.sim.follow_scenarios import SCENARIOS
+from reachglass.sim.runner import SimRunner
+from reachglass.types import Detection, LoomingObs, PerceptionResult, PersonObs, Telemetry
+
+DT = 1.0 / 15
+
+
+class RecDrone:
+    """Records rc; always flying."""
+
+    flying = True
+
+    def __init__(self):
+        self.sent = []
+
+    def rc(self, lr, fb, ud, yaw):
+        self.sent.append((lr, fb, ud, yaw))
+
+    def busy(self):
+        return False
+
+
+def person(range_m=2.5, bearing=10.0, track=1, box=(440, 300, 520, 380)):
+    det = Detection("person", 0.9, box, track_id=track)
+    return PersonObs(det, bearing, -5.0, range_m, "height_prior", None, 0.0, range_m)
+
+
+def setup(**avoid):
+    cfg = load_config(overrides={"follow": {"avoid": avoid}} if avoid else None)
+    ctx = Ctx(cfg, RecDrone(), Perception(cfg))
+    beh = FollowAvoid(cfg.follow)
+    beh.start(ctx)
+    return ctx, beh
+
+
+def step(ctx, beh, persons, locked=0, t=None, looming=None):
+    """One loop with a fresh frame: persons[locked] is the person we follow (locked=None: nobody locked)."""
+    ctx.now = ctx.now + DT if t is None else t
+    ctx.tel = Telemetry(ctx.now, yaw_deg=0.0, height_m=2.0, tof_m=2.0)
+    ctx.new_frame = True
+    res = PerceptionResult(ctx.now, int(ctx.now * 15), 0.0, (960, 720), [p.det for p in persons])
+    res.persons = persons
+    res.person = persons[locked] if (locked is not None and persons) else None
+    res.person_unseen_s = 0.0 if res.person is not None else 5.0
+    res.ran = {"person": True, "target": False, "context": False}
+    res.looming = looming
+    ctx.res = res
+    beh.step(ctx)
+    return ctx.drone.sent[-1]
+
+
+def run(ctx, beh, seconds, **kw):
+    return [step(ctx, beh, [person(**kw)]) for _ in range(int(seconds / DT))]
+
+
+# ------------------------------------------------------------------ brake
+def test_clear_corridor_follows_like_follow_behind():
+    ctx, beh = setup()
+    lr, fb, ud, yaw = run(ctx, beh, 1.0)[-1]
+    assert fb == 35 and yaw == 7 and lr == 0  # FollowBehind: max_rc_forward, 1.2 x (10 - 4 deg deadband)
+    assert "braking" not in beh.status
+
+
+def test_obstacle_in_corridor_brakes_and_yaw_stays_on_the_person():
+    ctx, beh = setup(sidestep=False)
+    ctx.grid.mark_blocked(0.9, 0.0, 0.2, weight=2.0)  # something tall 0.9 m ahead (unknown height)
+    sent = run(ctx, beh, 2.0)
+    assert all(fb <= 0 for _, fb, _, _ in sent)
+    assert all(yaw == 7 for *_, yaw in sent)  # the fly / PID keeps steering at the person
+    assert "ahead: braking" in beh.status and any(e.startswith("brake") for _, e in beh.events)
+
+
+def test_very_close_obstacle_backs_away_slowly():
+    ctx, beh = setup(sidestep=False)
+    ctx.grid.mark_blocked(0.45, 0.0, 0.1, weight=2.0)
+    _, fb, _, _ = run(ctx, beh, 0.5)[-1]
+    assert fb == -load_config().follow.avoid.reverse_rc
+
+
+def test_low_furniture_below_flight_height_does_not_brake():
+    ctx, beh = setup()
+    ctx.grid.mark_blocked(0.9, 0.0, 0.4, weight=2.0, top_m=0.75)  # a table: the drone at 2.0 m flies over it
+    _, fb, _, _ = run(ctx, beh, 1.0)[-1]
+    assert fb == 35
+
+
+def test_looming_brakes_while_flying_and_is_remembered():
+    ctx, beh = setup(sidestep=False)
+    run(ctx, beh, 1.5)  # flying forward at ~0.35 m/s
+    close = LoomingObs(0.0, rate=0.8, ttc_s=1.25, texture=1.0, dt_s=0.13)  # ~0.4 m at our speed
+    for _ in range(3):
+        close.t = ctx.now + DT
+        _, fb, _, yaw = step(ctx, beh, [person()], looming=close)
+    assert fb <= 0 and yaw == 7 and "looming" in beh.status
+    assert any(o.src == "looming" for o in beh.obstacles)  # kept ahead so a stopped drone does not creep on
+
+
+def test_one_noisy_looming_frame_or_a_fast_turn_does_not_brake():
+    ctx, beh = setup(sidestep=False)
+    run(ctx, beh, 1.5)
+    spike = LoomingObs(ctx.now + DT, rate=0.8, ttc_s=1.25, texture=1.0, dt_s=0.13)
+    _, fb, _, _ = step(ctx, beh, [person()], looming=spike)
+    assert fb > 0  # needs two frames in a row
+    ctx2, beh2 = setup(sidestep=False)
+    run(ctx2, beh2, 1.5, bearing=40.0)  # yaw stick 40: turning hard
+    for _ in range(3):
+        _, fb, _, _ = step(ctx2, beh2, [person(bearing=40.0)], looming=LoomingObs(ctx2.now + DT, 0.8, 1.25, texture=1.0))
+    assert fb > 0
+
+
+# ------------------------------------------------------------------ sidestep and keep-outs
+def test_blocked_for_long_sidesteps_toward_the_person_side():
+    ctx, beh = setup()
+    ctx.grid.mark_blocked(0.9, 0.0, 0.2, weight=2.0)
+    sent = run(ctx, beh, 3.5, bearing=15.0)  # the person is to the right of the obstacle
+    assert any(lr > 0 for lr, *_ in sent) and not any(lr < 0 for lr, *_ in sent)
+    assert all(fb <= 0 for _, fb, _, _ in sent) and all(yaw == 13 for *_, yaw in sent)
+    assert any(e.startswith("sidestep right") for _, e in beh.events)
+    assert ctx.odom.pose.y > 0.3  # dead reckoning moved us right
+
+
+def test_sidestep_never_ends_near_a_person():
+    ctx, beh = setup()
+    ctx.grid.mark_blocked(0.9, 0.0, 0.2, weight=2.0)
+    beh.obstacles.append(Obstacle(1e9, 0.0, -0.55, 0.1, math.inf, "potted plant"))  # no room on the left either
+    # the user straight ahead, a second person 1.2 m away on the right: sliding right would end ~0.8 m from them
+    other = person(range_m=1.2, bearing=80.0, track=2, box=(800, 300, 900, 380))
+    sent = [step(ctx, beh, [person(bearing=15.0), other]) for _ in range(int(3.5 / DT))]
+    assert not any(lr > 0 for lr, *_ in sent)
+    assert not any(e.startswith("sidestep") for _, e in beh.events)
+    assert "no room to sidestep" in beh.status or "braking" in beh.status
+
+
+def test_other_people_are_obstacles_the_followed_person_is_not():
+    ctx, beh = setup(sidestep=False)
+    stranger = person(range_m=1.2, bearing=0.0, track=2, box=(460, 330, 500, 360))
+    sent = [step(ctx, beh, [person(range_m=2.5, bearing=10.0), stranger]) for _ in range(10)]
+    assert sent[-1][1] <= 0
+    ctx2, beh2 = setup(sidestep=False)
+    assert run(ctx2, beh2, 0.7, range_m=2.5, bearing=0.0)[-1][1] == 35  # the user straight ahead: no brake
+
+
+def test_never_backs_into_something_mapped_behind():
+    ctx, beh = setup()
+    ctx.grid.mark_blocked(-0.6, 0.0, 0.2, weight=2.0)
+    _, fb, _, _ = run(ctx, beh, 0.5, range_m=0.4)[-1]  # the person is too close: FollowBehind backs off at -50
+    assert fb == 0 and "obstacle behind" in beh.status
+    ctx2, beh2 = setup()
+    assert run(ctx2, beh2, 0.5, range_m=0.4)[-1][1] == -50  # nothing behind: backs off as before
+
+
+def test_hovering_next_to_something_drifts_away_from_it():
+    ctx, beh = setup()
+    beh.obstacles.append(Obstacle(1e9, 0.0, 0.3, 0.05, math.inf, "potted plant"))  # right next to us on the right
+    lr, fb, _, _ = run(ctx, beh, 0.5, range_m=1.0, bearing=0.0)[-1]  # at the follow distance: hovering
+    assert lr < 0 and "keeping clear of the right" in beh.status
+
+
+def test_kill_switch_is_exactly_follow_behind():
+    cfg = load_config(overrides={"follow": {"avoid": {"enabled": False}}})
+    a_ctx, b_ctx = (Ctx(cfg, RecDrone(), Perception(cfg)) for _ in range(2))
+    a, b = FollowAvoid(cfg.follow), FollowBehind(cfg.follow)
+    a.start(a_ctx)
+    b.start(b_ctx)
+    for c in (a_ctx, b_ctx):
+        c.grid.mark_blocked(0.9, 0.0, 0.2, weight=2.0)
+    for i in range(40):
+        r, bearing = 2.5 - 0.05 * i, 10.0 - i
+        step(a_ctx, a, [person(r, bearing)], t=i * DT)
+        step(b_ctx, b, [person(r, bearing)], t=i * DT)
+    assert a_ctx.drone.sent == b_ctx.drone.sent and a_ctx.odom.pose.x == 0.0
+
+
+# ------------------------------------------------------------------ occlusion recovery
+def lose_behind_obstacle(ctx, beh, range_m=2.5, texture=1.0):
+    """Braking for something ahead while following; then the person vanishes (hidden by it). texture: how much
+    of the view ahead the looming estimator can measure (0 = a blank wall)."""
+    ctx.grid.mark_blocked(0.9, 0.0, 0.2, weight=2.0)
+    run(ctx, beh, 1.0, range_m=range_m, bearing=0.0)
+    assert "braking" in beh.status
+    ctx.grid = Grid(16.0, 0.25)  # the way toward where they were is clear again (e.g. after the sidestep)
+    return [step(ctx, beh, [], locked=None, looming=LoomingObs(ctx.now + DT, texture=texture)) for _ in range(int(1.5 / DT))]
+
+
+def test_person_hidden_while_braking_creeps_toward_where_they_were():
+    ctx, beh = setup()
+    lr, fb, ud, yaw = lose_behind_obstacle(ctx, beh)[-1]
+    assert fb == load_config().follow.avoid.recover_rc and abs(yaw) <= 2  # straight at their last spot, slowly
+    assert beh.reacquire_wait and "person hidden: creeping" in beh.status
+    assert any(e.startswith("recover:") for _, e in beh.events)
+    lr, fb, ud, yaw = run(ctx, beh, 0.5, range_m=2.0, bearing=0.0)[-1]  # seen again: normal following
+    assert fb == 35 and not beh.reacquire_wait and "hidden" not in beh.status
+    assert any("seen again" in e for _, e in beh.events)
+    ctx2, beh2 = setup()
+    assert lose_behind_obstacle(ctx2, beh2, texture=0.0)[-1][1] == 0  # a blank wall ahead: no creeping into it
+    assert "cannot see ahead" in beh2.status and beh2.reacquire_wait
+
+
+def test_recovery_stops_person_clearance_short_and_is_bounded():
+    ctx, beh = setup()
+    lr, fb, ud, yaw = lose_behind_obstacle(ctx, beh, range_m=1.05)[-1]  # last seen 1.05 m away: already close
+    assert fb == 0 and "facing where they were" in beh.status
+    ctx2, beh2 = setup(recover_max_s=0.5)
+    lose_behind_obstacle(ctx2, beh2)
+    assert not beh2.reacquire_wait and any("gave up" in e for _, e in beh2.events)  # the mission may reacquire
+
+
+def test_no_obstacle_no_recovery_and_kill_switch():
+    ctx, beh = setup()
+    run(ctx, beh, 1.0, range_m=2.5, bearing=5.0)  # following, nothing in the way
+    sent = [step(ctx, beh, [], locked=None) for _ in range(int(1.5 / DT))]
+    assert sent[-1][1] == 0 and sent[-1][3] == load_config().follow.search_yaw_rc  # FollowBehind's own search
+    assert not beh.reacquire_wait and not any(e.startswith("recover") for _, e in beh.events)
+    ctx2, beh2 = setup(recover=False)
+    assert lose_behind_obstacle(ctx2, beh2)[-1][1] == 0 and not beh2.reacquire_wait
+
+
+# ------------------------------------------------------------------ simulator scenarios (sim/follow_scenarios.py)
+def follow_run(name, avoid=True, seconds=45.0, seed=0):
+    world, xy, heading = SCENARIOS[name]()
+    cfg = load_config(overrides={"follow": {"avoid": {"enabled": avoid}}})
+    r = SimRunner(cfg, world=world, drone_xy=xy, drone_heading=heading, seed=seed)
+    r.run(seconds)
+    return r
+
+
+@pytest.mark.slow
+def test_doorway_header_is_a_real_threat_without_avoid():
+    r = follow_run("doorway", avoid=False, seconds=30.0)
+    assert r.sim.drone.collisions > 0  # the header is 3 cm above the follow altitude
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("name", sorted(SCENARIOS))
+def test_follow_scenarios_without_collisions(name):
+    r = follow_run(name)
+    assert r.sim.drone.collisions == 0, [e for e in r.sim.drone.events if "COLLISION" in e[1]][:3]
+    assert r.mission.state in ("FOLLOW", "REACQUIRE", "HOLD"), r.ctx.notes[-10:]
diff --git a/tests/test_looming.py b/tests/test_looming.py
new file mode 100644
index 0000000..11f4db5
--- /dev/null
+++ b/tests/test_looming.py
@@ -0,0 +1,138 @@
+"""follow.avoid step 1: the looming estimator (detect/looming.py) on synthetic frames."""
+
+import time
+
+import cv2
+import numpy as np
+import pytest
+
+from reachglass.config import load_config
+from reachglass.detect import LOOMING, DivergenceLooming, NullLooming
+from reachglass.perception import Perception
+from reachglass.types import Detection, Frame
+
+W, H, FPS = 960, 720, 30.0
+_rng = np.random.default_rng(0)
+TEX = cv2.normalize(cv2.GaussianBlur(_rng.integers(0, 255, (2 * H, 2 * W), dtype=np.uint8), (0, 0), 4), None, 0, 255,
+                    cv2.NORM_MINMAX)
+
+
+def view(scale=1.0, dx=0.0, dy=0.0):
+    """The textured wall seen zoomed by `scale` about the image centre (closer = bigger), shifted by dx, dy px."""
+    M = np.float32([[scale, 0, W / 2 - scale * W + dx], [0, scale, H / 2 - scale * H + dy]])
+    return cv2.cvtColor(cv2.warpAffine(TEX, M, (W, H)), cv2.COLOR_GRAY2BGR)
+
+
+def approach(rate):
+    """Scale at time t when closing on a wall with time-to-contact 1/rate at t=0."""
+    return lambda t: 1.0 / max(1e-3, 1.0 - rate * t)
+
+
+def run(make, n=24, exclude=None, loom=None):
+    loom = loom or DivergenceLooming()
+    obs = [loom.update(make(i / FPS), i / FPS, exclude) for i in range(n)]
+    return obs[-1], obs
+
+
+def test_static_scene_does_not_loom():
+    o, _ = run(lambda t: view())
+    assert o.rate == 0.0 and o.ttc_s is None and o.texture == 1.0
+
+
+def test_approaching_wall_looms_with_its_time_to_contact():
+    s = approach(0.5)  # TTC 2 s at t=0, ~1.3 s at the last frame
+    o, _ = run(lambda t: view(s(t)))
+    assert o.ttc_s is not None and 0.6 < o.ttc_s < 2.0, o.ttc_s
+    assert o.score > 0.3 and abs(o.x_frac - 0.5) < 0.3
+
+
+def test_receding_wall_does_not_loom():
+    o, _ = run(lambda t: view(1.0 / (1.0 + 0.5 * t)))
+    assert o.ttc_s is None and o.rate == 0.0
+    assert np.nanmax(o.cells) < 0.0  # it measured contraction, not nothing
+
+
+def test_sideways_motion_and_turning_do_not_loom():
+    # 3 px/frame at 960 px (~5 deg/s turn or a sideways drift) and a fast 12 px/frame pan
+    for speed in (3.0, 12.0):
+        o, _ = run(lambda t: view(1.0, dx=speed * t * FPS))
+        assert o.ttc_s is None or o.ttc_s > 3.0, (speed, o.ttc_s)
+
+
+def test_expansion_inside_the_locked_person_box_is_ignored():
+    box = (330, 210, 630, 510)  # the person ahead (they are SUPPOSED to be there) grows in the middle of the view
+    s = approach(0.8)
+
+    def frame(t):
+        img = view()
+        patch = view(s(t))
+        img[box[1]:box[3], box[0]:box[2]] = patch[box[1]:box[3], box[0]:box[2]]
+        return img
+
+    looming, _ = run(frame)
+    ignored, _ = run(frame, exclude=[box])
+    assert looming.ttc_s is not None and looming.ttc_s < 2.0  # without the exclusion it would brake...
+    assert ignored.ttc_s is None or ignored.ttc_s > 4.0, ignored.ttc_s  # ...with it, nothing looms
+
+
+def test_blank_wall_is_blind_not_clear():
+    blank = np.full((H, W, 3), 128, np.uint8)
+    o, _ = run(lambda t: blank)
+    assert o.texture == 0.0 and o.ttc_s is None  # nothing measurable: follow_avoid reports "looming blind"
+
+
+def test_gap_or_reset_needs_a_new_baseline():
+    loom = DivergenceLooming()
+    assert loom.update(view(), 0.0).cells is None  # no earlier frame yet
+    loom.update(view(), 0.2)
+    assert loom.update(view(), 5.0).cells is None  # 4.8 s gap: frames are not comparable
+    loom.reset()
+    assert not loom.hist
+
+
+def test_cost_per_frame_is_a_few_ms():
+    loom = DivergenceLooming()
+    s = approach(0.3)
+    imgs = [view(s(i / FPS)) for i in range(20)]
+    t0 = time.perf_counter()
+    for i, img in enumerate(imgs):
+        loom.update(img, i / FPS)
+    per_frame_ms = 1000 * (time.perf_counter() - t0) / len(imgs)
+    assert per_frame_ms < 6.0, per_frame_ms  # ~1 ms on an M-series laptop, 960 x 720 input
+
+
+def test_registry_and_perception_run_it_in_follow_only():
+    cfg = load_config()
+    assert isinstance(LOOMING.build(cfg.perception.looming), DivergenceLooming)
+    assert isinstance(LOOMING.build("null"), NullLooming)
+    per = Perception(cfg)  # built from the config, no model needed
+    per.set_mode("follow")
+    rs = [per.update(Frame(view(approach(0.5)(i / FPS)), i / FPS, i)) for i in range(10)]
+    assert rs[-1].looming is not None and rs[-1].looming.ttc_s is not None
+    per.set_mode("search")
+    assert per.update(Frame(view(), 1.0, 11)).looming is None
+    with pytest.raises(ValueError):  # follow.avoid.looming without the estimator must not fail silently
+        load_config(overrides={"perception": {"looming": {"kind": "null"}}})
+
+
+def test_perception_excludes_the_locked_persons_box():
+    from reachglass.detect import Detector
+
+    class OnePerson(Detector):
+        classes = ["person"]
+
+        def detect(self, image):
+            return [Detection("person", 0.9, (330, 210, 630, 510))]
+
+    box, s = (330, 210, 630, 510), approach(0.8)
+
+    def frame(i):
+        img = view()
+        img[box[1]:box[3], box[0]:box[2]] = view(s(i / FPS))[box[1]:box[3], box[0]:box[2]]
+        return Frame(img, i / FPS, i)
+
+    per = Perception(load_config(), OnePerson(), None, None)
+    per.set_mode("follow")
+    rs = [per.update(frame(i)) for i in range(24)]
+    assert rs[-1].person is not None
+    assert rs[-1].looming.ttc_s is None or rs[-1].looming.ttc_s > 4.0

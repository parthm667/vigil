index 0000000..2b8f219
--- /dev/null
+++ b/reachglass/behaviors/follow_avoid.py
@@ -0,0 +1,475 @@
+"""Follow-behind with obstacle avoidance (follow.avoid): FollowBehind decides, this only limits forward / lateral.
+
+Every step FollowBehind computes its rc exactly as before (yaw toward the person, forward for the distance,
+altitude, orbit, lost-person search). Its command is caught (RcTap) and sent after these checks:
+  map        furniture from the context detector (every 5th frame in follow) goes into memory + grid like the
+             search does (explore.observe, at most every map_every_s) and into a short list of recent
+             obstacles. While following, the pose is dead-reckoned from the rc actually sent
+             (Odometry.on_velocity), so what was seen stays put on the map
+  corridor   an obstacle reaching flight height (top + 0.2 m > altitude, the grid's rule) within corridor_m
+             ahead and half_width_m sideways, from the recent list or the grid -> BRAKE: forward capped at 0,
+             or backing away at reverse_rc when closer than reverse_m. Other people count (1 m keep-out);
+             the person we follow does not
+  looming    perception.looming (the person's box excluded): flying at v, a surface closer than v x TTC <
+             stop_range_m, or TTC < ttc_brake_s at any speed -> BRAKE for hold_s, and the patch is kept as
+             an obstacle ahead for memory_s (so a stopped drone does not creep back into it)
+  sidestep   blocked for > sidestep_after_s while it wants to go forward, or while the person is hidden behind
+             the obstacle: slide sidestep_m sideways with rc, toward the side where the person was (that side
+             reopens the view), if the grid shows room (as approach.py's sidestep: >= 0.5 m) and the whole
+             slide keeps person_clearance_m from every person
+  behind     no rear camera: never back into something mapped behind; hovering with something mapped right
+             beside us: drift away from it slowly
+  recover    the person vanished while (or within recover_window_s after) we braked / sidestepped: the obstacle
+             most likely hides them. For up to recover_max_s the yaw holds on where they were last seen (moved
+             on along their last walking direction, at most 1 m) and the drone creeps there at recover_rc (the
+             brake and sidestep above still apply, so it goes round the obstacle's free side), stopping
+             person_clearance_m short of that spot. It only creeps where looming can see (not turning hard,
+             enough texture ahead: a blank wall stops it) and at most recover_max_m in all. Meanwhile the mission does not switch to REACQUIRE
+             (reacquire_wait; its "lost" rule fires ~4.5 s after a loss once the person lock lets go). Seen
+             again -> normal following.
+             Not when they vanished close (walking under us): FollowBehind backs off then
+Yaw and altitude always stay FollowBehind's: the fly (or the PID) keeps steering at the person.
+enabled: false = FollowBehind exactly (kill switch).
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+from collections import deque
+from dataclasses import dataclass
+
+from ..config import FollowCfg
+from .base import Ctx, clamp, deadband
+from .explore import FOOTPRINT, observe
+from .follow import FollowBehind
+
+log = logging.getLogger("reachglass.behaviors")
+TOP_CLEARANCE_M = 0.2  # like Grid.blocks: furniture whose top is within this of flight height is an obstacle
+
+
+@dataclass
+class Obstacle:
+    t: float  # last seen
+    x: float  # mission frame (dead-reckoned while following)
+    y: float
+    radius: float
+    top: float  # highest point above the floor (inf = unknown / reaches any height)
+    src: str  # class name, "person" or "looming"
+
+
+class RcTap:
+    """Stands in for ctx.drone while FollowBehind.step runs: records its rc instead of sending it."""
+
+    def __init__(self, inner):
+        self.inner = inner
+        self.cmd: tuple[int, int, int, int] | None = None
+
+    def rc(self, lr: int, fb: int, ud: int, yaw: int) -> None:
+        self.cmd = (int(lr), int(fb), int(ud), int(yaw))
+
+    def __getattr__(self, name):
+        return getattr(self.inner, name)
+
+
+class FollowAvoid(FollowBehind):
+    name = "follow"
+
+    def __init__(self, cfg: FollowCfg):
+        super().__init__(cfg)
+        self.a = cfg.avoid
+        self._reset(0.0)
+
+    def _reset(self, now: float) -> None:
+        self.obstacles: list[Obstacle] = []
+        self.blocked_since: float | None = None
+        self.clear_since: float | None = now
+        self.brake_until = -math.inf
+        self.side = 0  # sidestep in progress: -1 left, +1 right
+        self.side_from = (0.0, 0.0)
+        self.side_t0 = 0.0
+        self.sidesteps = 0
+        self.v = [0.0, 0.0]  # dead-reckoned body speed (forward, right), m/s
+        self.v_hist: deque = deque(maxlen=60)  # (t, forward m/s)
+        self.last_dr_t: float | None = None
+        self.last_map_t = -math.inf
+        self.sent = (0, 0, 0, 0)
+        self.loom = None  # latest LoomingObs
+        self.person_xy: tuple[float, float] | None = None  # where the followed person was last seen
+        self.person_xy_t = -math.inf
+        self.person_track: deque = deque(maxlen=40)  # (t, x, y) of the followed person, mission frame
+        self.why = ""  # current avoidance reason (status / log)
+        self.events: list[tuple[float, str]] = []  # (t, what) for tests and the run log
+        self.blocked_by: Obstacle | None = None
+        self.braking = False
+        self.loom_why = "looming"
+        self.loom_streak = 0
+        self.recover_why = ""
+        self.recover_from = (0.0, 0.0)
+        self.recover_path_m = 0.0
+        self.loom_hit_t = -1.0
+        self.yaw_hist: deque = deque(maxlen=40)  # (t, yaw rc sent)
+        self.avoid_active_t = -math.inf  # last time we braked or sidestepped
+        self.recover_t0: float | None = None  # occlusion recovery running since
+        self.recover_done = False  # one recovery per loss
+        self.reacquire_wait = False  # read by Mission: an obstacle hides the person and we are going round it
+
+    def start(self, ctx: Ctx) -> None:
+        super().start(ctx)
+        self._reset(ctx.now)
+
+    # ------------------------------------------------------------------ main
+    def step(self, ctx: Ctx) -> str:
+        if not self.a.enabled:
+            return super().step(ctx)
+        self._dead_reckon(ctx)
+        self._map(ctx)
+        tap = RcTap(ctx.drone)
+        ctx.drone = tap
+        try:
+            r = super().step(ctx)
+        finally:
+            ctx.drone = tap.inner
+        if tap.cmd is None:
+            return r
+        lr, fb, ud, yaw = tap.cmd
+        rec = self._recover(ctx) if self.a.recover else None
+        if rec is not None:
+            lr, fb, yaw = rec  # ud stays FollowBehind's altitude hold
+        lr, fb, ud, yaw = self._avoid(ctx, lr, fb, ud, yaw)
+        ctx.drone.rc(lr, fb, ud, yaw)  # yaw and ud as FollowBehind decided (recovering: yaw on the remembered spot)
+        self.sent = (lr, fb, ud, yaw)
+        self.yaw_hist.append((ctx.now, yaw))
+        # FollowBehind's approach-rate feed-forward subtracts our own speed: it must see what was really sent
+        if self.fwd_hist and self.fwd_hist[-1][0] == ctx.now:
+            self.fwd_hist[-1] = (ctx.now, fb)
+        if rec is not None:  # FollowBehind's "person lost: turning" is not what happens now
+            self.status = self.recover_why + (f" | {self.why}" if self.why else "")
+        elif self.why:
+            self.status = f"{self.status} | {self.why}"
+        return r
+
+    # ------------------------------------------------------------------ sensing
+    def _dead_reckon(self, ctx: Ctx) -> None:
+        """Advance the pose with the rc we sent, through the stick's first-order lag (like the sim / latency test)."""
+        now = ctx.now
+        dt = 0.0 if self.last_dr_t is None else now - self.last_dr_t
+        self.last_dr_t = now
+        if dt <= 0 or dt > 0.5:
+            return
+        k = 1.0 - math.exp(-dt / self.a.rc_tau_s)
+        lr, fb = self.sent[0], self.sent[1]
+        self.v[0] += (fb / 100.0 * self.a.rc_mps - self.v[0]) * k
+        self.v[1] += (lr / 100.0 * self.a.rc_mps - self.v[1]) * k
+        ctx.odom.on_velocity(self.v[0], self.v[1], dt)
+        self.v_hist.append((now, self.v[0]))
+
+    def _speed_at(self, t: float) -> float:
+        """Our forward speed (m/s) at time t (the moment a frame was captured), from the dead reckoning."""
+        best = 0.0
+        for ts, v in self.v_hist:
+            if ts <= t:
+                best = v
+        return best
+
+    def _map(self, ctx: Ctx) -> None:
+        res = ctx.res
+        if not ctx.new_frame or res is None:
+            return
+        now, pose, alt = ctx.now, ctx.odom.pose, ctx.altitude
+        self.obstacles = [o for o in self.obstacles if now - o.t <= self.a.memory_s]
+        if res.person is not None and res.person.range_m is not None:
+            self.person_xy, self.person_xy_t = pose.point_at(res.person.range_m, res.person.bearing_deg), now
+            self.person_track.append((now, *self.person_xy))
+        for p in res.persons:  # OTHER people (only with the person locked): 1 m keep-out, whatever their height
+            if res.person is not None and p.range_m is not None and p.det.track_id != res.person.det.track_id:
+                self.obstacles.append(Obstacle(now, *pose.point_at(p.range_m, p.bearing_deg), 0.5, math.inf, "person"))
+        if res.looming is not None:
+            self.loom = res.looming
+        if not (res.ran.get("context") or res.ran.get("target")):
+            return
+        cam = ctx.perception.camera.for_frame(*res.image_size)
+        heights = ctx.cfg.perception.object_heights_m
+        for o in res.context:
+            rng, top = o.range_m, math.inf
+            if rng is None and alt is not None and o.cls in heights and o.det.bbox[1] > 3:
+                # close to a tall object only its top is in frame (the camera cannot tilt): range from the
+                # elevation of its top edge and its class height, like the person's head-elevation cue
+                rng = cam.range_to_height(o.det.cx, o.det.bbox[1], alt - heights[o.cls])
+                top = heights[o.cls]
+            if rng is None:
+                continue
+            if top == math.inf and alt is not None and o.det.bbox[1] > 3:
+                el = cam.elevation_deg(o.det.bbox[1], 0.0, o.det.cx)  # same as explore.observe
+                top = max(0.0, alt + rng * math.tan(math.radians(el)))
+            x, y = pose.point_at(rng, o.bearing_deg)
+            self.obstacles.append(Obstacle(now, x, y, FOOTPRINT.get(o.cls, 0.3), top, o.cls))
+        if now - self.last_map_t >= self.a.map_every_s:
+            self.last_map_t = now
+            observe(ctx, mark_view=False)  # memory + grid, exactly as the search / approach do
+
+    # ------------------------------------------------------------------ geometry
+    def _reaches_us(self, o: Obstacle, alt: float | None) -> bool:
+        return alt is None or o.top + TOP_CLEARANCE_M > alt
+
+    def _body(self, ctx: Ctx, x: float, y: float) -> tuple[float, float]:
+        """World point -> (ahead, right) of the drone, metres."""
+        pose = ctx.odom.pose
+        h = math.radians(pose.heading_deg)
+        dx, dy = x - pose.x, y - pose.y
+        return dx * math.cos(h) + dy * math.sin(h), -dx * math.sin(h) + dy * math.cos(h)
+
+    def _ahead(self, ctx: Ctx) -> tuple[float | None, Obstacle | None]:
+        """Distance to the nearest obstacle in the forward corridor (None = clear), and which one (None = grid)."""
+        a, alt = self.a, ctx.altitude
+        best, which = None, None
+        for o in self.obstacles:
+            if not self._reaches_us(o, alt):
+                continue  # the drone flies over it (a chair at 2 m altitude)
+            ahead, right = self._body(ctx, o.x, o.y)
+            if ahead > 0 and abs(right) < o.radius + a.half_width_m:
+                d = max(0.0, ahead - o.radius)
+                if d < a.corridor_m and (best is None or d < best):
+                    best, which = d, o
+        if a.use_map:
+            pose = ctx.odom.pose
+            for off in (-a.half_width_m, 0.0, a.half_width_m):
+                start = pose.moved(right_m=off)
+                d = ctx.grid.clear_distance(start, pose.heading_deg, a.corridor_m, unknown_ok_m=a.corridor_m,
+                                            margin_m=0.0, altitude_m=alt)
+                if d < a.corridor_m - 1e-6 and (best is None or d < best):
+                    best, which = d, None
+        return best, which
+
+    def _room(self, ctx: Ctx, heading_off: float, dist_m: float) -> float:
+        """Free distance from the drone along heading + heading_off (grid and recent obstacles)."""
+        pose, alt = ctx.odom.pose, ctx.altitude
+        room = ctx.grid.clear_distance(pose, pose.heading_deg + heading_off, dist_m, unknown_ok_m=dist_m,
+                                       margin_m=0.0, altitude_m=alt)
+        h = math.radians(heading_off)
+        ux, uy = math.cos(h), math.sin(h)  # direction in the body frame (ahead, right)
+        for o in self.obstacles:
+            if not self._reaches_us(o, alt):
+                continue
+            ahead, right = self._body(ctx, o.x, o.y)
+            along = ahead * ux + right * uy
+            if along > 0 and abs(-ahead * uy + right * ux) < o.radius + 0.15:
+                room = min(room, max(0.0, along - o.radius))
+        return room
+
+    def _people(self, ctx: Ctx) -> list[tuple[float, float]]:
+        pts = []
+        pose = ctx.odom.pose
+        if ctx.res is not None:
+            pts += [pose.point_at(p.range_m, p.bearing_deg) for p in ctx.res.persons if p.range_m is not None]
+        if self.person_xy is not None and ctx.now - self.person_xy_t <= 3.0:
+            pts.append(self.person_xy)
+        return pts
+
+    def _slide_keeps_clear(self, ctx: Ctx, side: int) -> bool:
+        """The whole sideways slide keeps person_clearance_m from every person (or at least does not get closer)."""
+        pose = ctx.odom.pose
+        end = pose.moved(right_m=side * self.a.sidestep_m)
+        for px, py in self._people(ctx):
+            now_d = pose.distance_to(px, py)
+            worst = min(math.hypot(pose.x + k / 10 * (end.x - pose.x) - px, pose.y + k / 10 * (end.y - pose.y) - py)
+                        for k in range(11))
+            if worst < min(self.a.person_clearance_m, now_d - 0.05):
+                return False
+        return True
+
+    def _choose_side(self, ctx: Ctx, obstacle: Obstacle | None) -> int:
+        """Toward where the person was (that reopens the view), else away from the obstacle; needs room like
+        approach.py's sidestep (>= 0.5 m free within 0.8 m) and the person keep-out."""
+        o_right = 0.0 if obstacle is None else self._body(ctx, obstacle.x, obstacle.y)[1]
+        if obstacle is None and self.loom is not None and self.loom.ttc_s is not None:
+            o_right = self.loom.x_frac - 0.5  # looming patch left or right of centre
+        prefer = -1 if o_right > 0 else 1
+        if self.person_xy is not None and ctx.now - self.person_xy_t <= 10.0:
+            p_right = self._body(ctx, *self.person_xy)[1]
+            prefer = 1 if p_right > o_right else -1
+        for side in (prefer, -prefer):
+            if self._room(ctx, 90 * side, 0.8) >= 0.5 and self._slide_keeps_clear(ctx, side):
+                return side
+        return 0
+
+    # ------------------------------------------------------------------ decision
+    def _event(self, ctx: Ctx, what: str) -> None:
+        self.events.append((ctx.now, what))
+        ctx.note(f"follow avoid: {what}")
+
+    def _looming_brake(self, ctx: Ctx) -> str | None:
+        a, L = self.a, self.loom
+        if not a.looming or L is None or ctx.now - L.t > 0.5:
+            return None
+        if any(abs(y) > a.max_yaw_rc for t, y in self.yaw_hist if ctx.now - t <= 0.6):
+            return None  # turning hard: what is left of the rotation after derotation reads as looming
+        if L.t == self.loom_hit_t:
+            return None  # this frame was already judged (the brake holds for hold_s)
+        self.loom_hit_t = L.t
+        if L.texture < a.min_texture:
+            return None
+        if L.ttc_s is None:
+            return None
+        v = self._speed_at(L.t - L.dt_s / 2)  # our speed while those two frames were taken
+        dist = v * L.ttc_s if v >= a.min_speed_mps else None
+        # hovering: only something coming at us fast; flying: close AND soon (the range from a slow speed is noise)
+        hit = (L.ttc_s < a.ttc_brake_s) if dist is None else (L.ttc_s < a.ttc_move_s and dist < a.stop_range_m)
+        self.loom_streak = self.loom_streak + 1 if hit else 0
+        if self.loom_streak >= 2:  # two frames in a row: one noisy frame does not stop the drone
+            # remember it as an obstacle ahead, where the looming patch is
+            cam = ctx.perception.camera.for_frame(*ctx.res.image_size) if ctx.res is not None else ctx.perception.camera
+            bearing = cam.bearing_deg(L.x_frac * cam.width)
+            r = min(max(dist if dist is not None else 0.7 * a.stop_range_m, 0.3), a.corridor_m)
+            x, y = ctx.odom.pose.point_at(r + 0.3, bearing)
+            self.obstacles.append(Obstacle(ctx.now, x, y, 0.3, math.inf, "looming"))
+            return f"looming TTC {L.ttc_s:.1f} s" + (f" (~{dist:.1f} m)" if dist is not None else "")
+        return None
+
+    # ------------------------------------------------------------------ occlusion recovery
+    def _recover(self, ctx: Ctx) -> tuple[int, int, int] | None:
+        """(lateral, forward, yaw) while creeping toward where the hidden person was last seen, else None."""
+        a, now, c = self.a, ctx.now, self.c
+        unseen = math.inf if self.last_seen_t is None else now - self.last_seen_t
+        if unseen < 0.5 or self.person_xy is None:
+            if unseen < 0.5 and self.recover_t0 is not None:
+                self._event(ctx, f"recover: person seen again after {now - self.recover_t0:.1f} s")
+            if unseen < 0.5:
+                self.recover_t0, self.recover_done = None, False
+            self.reacquire_wait = False
+            return None
+        if self.recover_t0 is None:
+            # start only if an obstacle explains the loss: we were braking / sidestepping when they vanished
+            explained = self.avoid_active_t >= self.last_seen_t - a.recover_window_s
+            if self.recover_done or not explained or self.last_close or now - self.person_xy_t > 1.5:
+                self.reacquire_wait = False
+                return None
+            self.recover_t0 = now
+            self.recover_from = (ctx.odom.pose.x, ctx.odom.pose.y)
+            self.recover_path_m = 0.0
+            self._event(ctx, "recover: person hidden behind the obstacle, creeping toward where they were")
+        spent = now - self.recover_t0
+        if spent > a.recover_max_s:
+            if not self.recover_done:
+                self._event(ctx, f"recover: gave up after {a.recover_max_s:.0f} s")
+            self.recover_done, self.recover_t0, self.reacquire_wait = True, None, False
+            return None
+        self.reacquire_wait = True
+        pose = ctx.odom.pose
+        tx, ty = self._where_they_went()
+        bearing = pose.bearing_to(tx, ty)
+        yaw = clamp(deadband(bearing, c.yaw_deadband_deg) * c.yaw_gain, c.max_rc_yaw)
+        fly = getattr(self, "fly", None)  # fruit fly steering (follow.steering: fly), if present: it steers
+        if fly is not None:
+            try:
+                yaw = clamp(fly.yaw(now, bearing, None, now, fallback=yaw), c.max_rc_yaw)
+            except Exception:  # noqa: BLE001 - any fly problem: keep the PID yaw on the remembered bearing
+                pass
+        self.recover_path_m += pose.distance_to(*self.recover_from)
+        self.recover_from = (pose.x, pose.y)
+        left = pose.distance_to(tx, ty) - a.person_clearance_m  # stop this short of their last spot
+        # creep only where looming can see: turn first (a hard turn switches looming off), no blank wall ahead
+        turning = any(abs(y) > a.max_yaw_rc for t, y in self.yaw_hist if now - t <= 0.6) or abs(yaw) > a.max_yaw_rc
+        L = self.loom
+        blind = a.looming and (L is None or now - L.t > 0.5 or L.texture < a.min_texture)
+        fwd = a.recover_rc if (left > 0.1 and abs(bearing) < 15.0 and not turning and not blind
+                               and self.recover_path_m < a.recover_max_m) else 0
+        if fwd:
+            self.recover_why = f"person hidden: creeping to where they were ({left:.1f} m, {spent:.0f}/{a.recover_max_s:.0f} s)"
+        else:
+            why = ("turning to" if turning else "cannot see ahead, facing" if blind else "facing")
+            self.recover_why = f"person hidden: {why} where they were ({spent:.0f} s)"
+        return 0, int(fwd), int(yaw)
+
+    def _where_they_went(self) -> tuple[float, float]:
+        """Last-seen position moved on along their walking direction of the last second before (<= 1 m)."""
+        x, y = self.person_xy
+        h = [p for p in self.person_track if self.person_xy_t - p[0] <= 1.0]
+        if len(h) < 5 or h[-1][0] - h[0][0] < 0.5:
+            return x, y
+        vx, vy = (h[-1][1] - h[0][1]) / (h[-1][0] - h[0][0]), (h[-1][2] - h[0][2]) / (h[-1][0] - h[0][0])
+        d = math.hypot(vx, vy)
+        if d < 0.1:  # standing (or range noise)
+            return x, y
+        k = min(1.0, d * 3.0) / d  # where they get to in ~3 s at that pace, at most 1 m further
+        return x + vx * k, y + vy * k
+
+    def _avoid(self, ctx: Ctx, lr: int, fb: int, ud: int, yaw: int) -> tuple[int, int, int, int]:
+        a, now, pose = self.a, ctx.now, ctx.odom.pose
+        want_fwd = fb > 0
+        loom_why = self._looming_brake(ctx)
+        if loom_why is not None:
+            self.brake_until = now + a.hold_s
+            self.loom_why = loom_why
+        dist, which = self._ahead(ctx)
+        blocked = dist is not None or now < self.brake_until
+        why = ""
+        if dist is not None:
+            what = "mapped obstacle" if which is None else ("looming patch" if which.src == "looming" else which.src)
+            why = f"{what} {dist:.1f} m ahead: braking"
+        elif blocked:
+            why = f"{self.loom_why}: braking"
+        if blocked and not self.braking:
+            self._event(ctx, f"brake: {loom_why or why}")
+        self.braking = blocked
+        if blocked or self.side:
+            self.avoid_active_t = now
+        self.blocked_by = which
+        # the person vanished behind the obstacle (seen in the last 10 s): sidestepping may bring them back
+        unseen = math.inf if self.last_seen_t is None else now - self.last_seen_t
+        hidden = blocked and 0.5 < unseen < 10.0
+        if blocked and (want_fwd or hidden):
+            self.blocked_since = self.blocked_since or now
+            self.clear_since = None
+        elif not blocked:
+            if self.blocked_since is not None:
+                self._event(ctx, "clear")
+            self.blocked_since = None
+            self.clear_since = self.clear_since or now
+            if now - self.clear_since > 2.0:
+                self.sidesteps = 0
+        if blocked:
+            # back away only from something SEEN (a looming range is too rough to reverse blind on)
+            seen = dist is not None and (which is None or which.src != "looming")
+            cap = -a.reverse_rc if (seen and dist < a.reverse_m) else 0
+            fb = min(fb, cap)
+        # sidestep: rc sideways while FollowBehind keeps the yaw on the person
+        if self.side:
+            moved = pose.distance_to(*self.side_from)
+            too_long = now - self.side_t0 > a.sidestep_m / max(0.05, a.sidestep_rc / 100.0 * a.rc_mps) + 2.0
+            if moved >= a.sidestep_m or too_long or not self._slide_keeps_clear(ctx, self.side):
+                self._event(ctx, f"sidestep done ({moved:.2f} m)")
+                self.side = 0
+                self.blocked_since = now if blocked else None  # another one only after sidestep_after_s again
+            else:
+                lr = self.side * a.sidestep_rc
+                fb = min(fb, 0)
+                why = f"sidestep {'right' if self.side > 0 else 'left'} ({moved:.1f}/{a.sidestep_m:.1f} m)"
+        elif (a.sidestep and self.blocked_since is not None and now - self.blocked_since > a.sidestep_after_s
+              and self.sidesteps < a.max_sidesteps):
+            side = self._choose_side(ctx, which)
+            if side:
+                self.side, self.side_from, self.side_t0 = side, (pose.x, pose.y), now
+                self.sidesteps += 1
+                self._event(ctx, f"sidestep {'right' if side > 0 else 'left'} {a.sidestep_m:.1f} m")
+                lr, fb = side * a.sidestep_rc, min(fb, 0)
+                why = f"blocked {now - self.blocked_since:.1f} s: sidestep {'right' if side > 0 else 'left'}"
+            elif blocked:
+                why += " (no room to sidestep)"
+        # no rear camera: never back into something mapped behind us
+        if fb < 0 and self._room(ctx, 180, 0.8) < 0.8:
+            fb = 0
+            why = (why + "; " if why else "") + "obstacle behind: not backing off"
+        # hovering next to something mapped: drift away from it slowly
+        if not self.side and lr == 0 and abs(fb) < 5:
+            left, right = self._room(ctx, -90, 0.5), self._room(ctx, 90, 0.5)
+            if min(left, right) < 0.35:
+                lr = 10 if left < right else -10
+                why = (why + "; " if why else "") + f"keeping clear of the {'left' if left < right else 'right'}"
+        if (self.loom is not None and a.looming and self.loom.texture < a.min_texture and ctx.now - self.loom.t < 0.5
+                and not why):
+            why = "looming blind (no texture ahead)"
+        if why != self.why and why:
+            log.info("follow avoid: %s", why)
+        self.why = why
+        return int(lr), int(fb), ud, yaw

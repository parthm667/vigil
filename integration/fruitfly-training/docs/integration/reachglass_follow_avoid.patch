index 0000000..067a278
--- /dev/null
+++ b/reachglass/detect/looming.py
@@ -0,0 +1,223 @@
+"""Looming: is something ahead getting closer? From the expansion of the forward view (no model, ~1-2 ms).
+
+    loom = LOOMING.build(cfg.perception.looming)                # ComponentSpec: divergence | null
+    obs = loom.update(frame.image, frame.t, exclude=[person_box])   # LoomingObs (types.py)
+
+This is the fruit fly's looming channel (LPLC2 / LC4 in the FlyDrones retina, which it is adapted from:
+third_party/FlyDrones/src/flydrones/senses/retina.py, MIT licence, (c) 2026 SpikeCalls and FlyDrones
+contributors), redone for a single forward Tello camera:
+  1. grey, downsampled to ~96 x 72, blurred
+  2. compared with the frame ~baseline_s earlier. The drone's own ROTATION is removed first: the global
+     image shift (coarse-to-fine Lucas-Kanade; mostly yaw/pitch) is undone, so turning toward the person
+     does not look like looming (fast turns still can: follow_avoid.py ignores looming while yawing hard)
+  3. each cell of a grid over the central forward region fits brightness constancy with a local similarity
+     motion  u = a + s x - w y,  v = b + s y + w x   (a, b: shift, s: expansion, w: roll). s / dt is
+     1 / time-to-contact of that patch: a surface at distance Z approached at speed V gives s / dt = V / Z.
+     Sideways motion (parallax) only shifts a cell, so it does not count as looming.
+  4. pixels inside the excluded boxes (the locked person: they are SUPPOSED to be ahead) have no weight.
+     A cell only reports when its expansion is measurable (standard error below max_se_per_s): a blank
+     wall or a dark room gives NO looming, which is not the same as "clear" (see LoomingObs.texture).
+The drone's own FORWARD motion is not removed here (it is exactly what makes a static obstacle loom):
+the follow behaviour turns rate into a distance with the speed it commanded (behaviors/follow_avoid.py).
+"""
+
+from __future__ import annotations
+
+import math
+import time
+from abc import ABC, abstractmethod
+from collections import deque
+
+import cv2
+import numpy as np
+
+from ..types import LoomingObs
+
+
+class LoomingEstimator(ABC):
+    @abstractmethod
+    def update(self, image: np.ndarray, t: float, exclude: list | None = None) -> LoomingObs:
+        """image: BGR (or grey) frame; t: frame time (s); exclude: boxes (x1, y1, x2, y2) in pixels to ignore."""
+
+    def reset(self) -> None:
+        """Forget old frames (after a jump: a discrete move/rotation, a mode change)."""
+
+
+class NullLooming(LoomingEstimator):
+    """Never looms. Used to disable the slot without special cases elsewhere."""
+
+    def update(self, image, t, exclude=None) -> LoomingObs:
+        return LoomingObs(t)
+
+
+class DivergenceLooming(LoomingEstimator):
+    def __init__(self, width: int = 96, height: int = 72, roi=(0.15, 0.15, 0.85, 0.85), grid=(3, 4),
+                 baseline_s: float = 0.12, max_baseline_s: float = 0.4, blur: int = 5, max_se_per_s: float = 0.12,
+                 min_rate: float = 0.05, smooth: float = 0.5, gain: float = 1.0, exclude_margin: float = 0.15,
+                 fov_deg: float = 55.0, derotate: bool = True):
+        """baseline_s: compare with the frame this long ago (longer = more sensitive, more motion to undo).
+        max_se_per_s: a cell reports only if its rate is known to +-this (1/s). min_rate: below this nothing
+        looms (TTC > 1 / min_rate s). smooth: EMA weight of the previous rate per cell. gain: score = rate * gain.
+        fov_deg: horizontal field of view of the stream (for the rotation homography; Tello stream ~55 deg)."""
+        self.w, self.h = int(width), int(height)
+        self.roi = tuple(float(v) for v in roi)
+        self.rows, self.cols = int(grid[0]), int(grid[1])
+        self.baseline_s, self.max_baseline_s = baseline_s, max_baseline_s
+        self.blur = int(blur) | 1
+        self.max_se_per_s, self.min_rate, self.smooth, self.gain = max_se_per_s, min_rate, smooth, gain
+        self.exclude_margin = exclude_margin
+        self.derotate = derotate
+        self.f = (self.w / 2.0) / math.tan(math.radians(fov_deg) / 2.0)
+        self.K = np.array([[self.f, 0.0, self.w / 2.0], [0.0, self.f, self.h / 2.0], [0.0, 0.0, 1.0]])
+        self.K_inv = np.linalg.inv(self.K)
+        # cell layout inside the ROI (whole pixels, same size for every cell)
+        x0, y0 = int(round(self.roi[0] * self.w)), int(round(self.roi[1] * self.h))
+        self.cw = max(4, int(round((self.roi[2] - self.roi[0]) * self.w / self.cols)))
+        self.ch = max(4, int(round((self.roi[3] - self.roi[1]) * self.h / self.rows)))
+        self.x0, self.y0 = x0, y0
+        xl = np.arange(self.cw, dtype=np.float32) - (self.cw - 1) / 2.0
+        yl = np.arange(self.ch, dtype=np.float32) - (self.ch - 1) / 2.0
+        self._xl, self._yl = np.meshgrid(xl, yl)  # local coordinates inside a cell (ch, cw)
+        xg = np.arange(self.cols * self.cw, dtype=np.float32) - (self.cols * self.cw - 1) / 2.0
+        yg = np.arange(self.rows * self.ch, dtype=np.float32) - (self.rows * self.ch - 1) / 2.0
+        self._xg, self._yg = np.meshgrid(xg, yg)  # coordinates over the whole ROI (one big cell)
+        self.hist: deque = deque(maxlen=30)  # (t, grey small image, exclusion mask)
+        self._ema: np.ndarray | None = None
+        self._g_ema: float | None = None
+
+    def reset(self) -> None:
+        self.hist.clear()
+        self._ema = None
+        self._g_ema = None
+
+    # ------------------------------------------------------------------ helpers
+    def _small(self, image: np.ndarray) -> np.ndarray:
+        g = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
+        g = cv2.resize(g, (self.w, self.h), interpolation=cv2.INTER_AREA).astype(np.float32)
+        return cv2.GaussianBlur(g, (self.blur, self.blur), 0) if self.blur > 1 else g
+
+    def _mask(self, exclude, full_w: int, full_h: int) -> np.ndarray:
+        m = np.ones((self.h, self.w), np.float32)
+        sx, sy = self.w / full_w, self.h / full_h
+        for b in exclude or []:
+            x1, y1, x2, y2 = b
+            mx, my = self.exclude_margin * (x2 - x1), self.exclude_margin * (y2 - y1)
+            c0, c1 = max(0, int((x1 - mx) * sx)), min(self.w, int(math.ceil((x2 + mx) * sx)))
+            r0, r1 = max(0, int((y1 - my) * sy)), min(self.h, int(math.ceil((y2 + my) * sy)))
+            m[r0:r1, c0:c1] = 0.0
+        return m
+
+    def _rotation(self, dx: float, dy: float) -> np.ndarray:
+        """Homography prev -> cur of a pure camera rotation that shifts the image centre by (dx, dy) px."""
+        yaw, pitch = math.atan2(dx, self.f), -math.atan2(dy, self.f)
+        cy, sy, cp, sp = math.cos(yaw), math.sin(yaw), math.cos(pitch), math.sin(pitch)
+        r_yaw = np.array([[cy, 0.0, sy], [0.0, 1.0, 0.0], [-sy, 0.0, cy]])
+        r_pitch = np.array([[1.0, 0.0, 0.0], [0.0, cp, -sp], [0.0, sp, cp]])
+        return self.K @ r_yaw @ r_pitch @ self.K_inv
+
+    def _shift(self, prev: np.ndarray, cur: np.ndarray) -> tuple[float, float]:
+        """Global image shift prev -> cur (px): gradient-weighted Lucas-Kanade, coarse to fine. Strong edges
+        dominate, so a static pattern (sensor dirt, the simulator's fixed noise) does not pin it at zero."""
+        dx = dy = 0.0
+        for scale in (0.25, 0.5, 1.0):
+            w, h = max(8, int(self.w * scale)), max(8, int(self.h * scale))
+            p = cv2.resize(prev, (w, h), interpolation=cv2.INTER_AREA) if scale < 1 else prev
+            c = cv2.resize(cur, (w, h), interpolation=cv2.INTER_AREA) if scale < 1 else cur
+            for _ in range(2):
+                M = np.float32([[1, 0, dx * scale], [0, 1, dy * scale]])
+                pw = cv2.warpAffine(p, M, (w, h), borderMode=cv2.BORDER_REPLICATE)
+                gy, gx = np.gradient(0.5 * (pw + c))
+                gt = (c - pw)[2:-2, 2:-2]
+                gx, gy = gx[2:-2, 2:-2], gy[2:-2, 2:-2]
+                A = np.array([[(gx * gx).sum(), (gx * gy).sum()], [(gx * gy).sum(), (gy * gy).sum()]]) + 1e-3 * np.eye(2)
+                u = np.linalg.solve(A, -np.array([(gx * gt).sum(), (gy * gt).sum()]))
+                dx, dy = dx + float(u[0]) / scale, dy + float(u[1]) / scale
+        return dx, dy
+
+    def _cells(self, a: np.ndarray) -> np.ndarray:
+        """(h, w) -> (rows, cols, ch, cw) over the ROI."""
+        a = a[self.y0:self.y0 + self.rows * self.ch, self.x0:self.x0 + self.cols * self.cw]
+        return a.reshape(self.rows, self.ch, self.cols, self.cw).transpose(0, 2, 1, 3)
+
+    # ------------------------------------------------------------------ main
+    def update(self, image: np.ndarray, t: float, exclude: list | None = None) -> LoomingObs:
+        t0 = time.perf_counter()
+        cur = self._small(image)
+        mask = self._mask(exclude, image.shape[1], image.shape[0])
+        # the frame ~baseline_s ago (the newest one at least that old)
+        prev = None
+        for item in reversed(self.hist):
+            if t - item[0] >= self.baseline_s - 1e-6:
+                prev = item
+                break
+        self.hist.append((t, cur, mask))
+        out = LoomingObs(t, roi=self.roi)
+        if prev is None or t - prev[0] > self.max_baseline_s or t <= prev[0]:
+            self._ema = self._g_ema = None
+            out.latency_ms = 1000.0 * (time.perf_counter() - t0)
+            return out
+        dt = t - prev[0]
+        p_img, p_mask = prev[1], prev[2]
+        valid = mask * p_mask
+        if self.derotate:
+            dx, dy = self._shift(p_img, cur)
+            if abs(dx) < 0.3 * self.w and abs(dy) < 0.3 * self.h:
+                # a plain shift: on simulator renders it left a smaller residual than the full rotation homography
+                # (self._rotation, kept for a real-drone comparison); fast turns are gated in follow_avoid.py
+                M = np.float32([[1, 0, dx], [0, 1, dy]])
+                p_img = cv2.warpAffine(p_img, M, (self.w, self.h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
+                inside = cv2.warpAffine(np.ones_like(cur), M, (self.w, self.h), flags=cv2.INTER_NEAREST)
+                valid = mask * cv2.warpAffine(p_mask, M, (self.w, self.h), flags=cv2.INTER_NEAREST) * inside
+        avg = 0.5 * (cur + p_img)
+        iy, ix = np.gradient(avg)
+        it = cur - p_img
+        # per cell, with local coordinates
+        rate, se, n = self._fit(self._cells(ix), self._cells(iy), self._cells(it), self._cells(valid), self._xl, self._yl, dt)
+        # the whole ROI as one more cell: a doorway or a box with an edge on each side is measurable as a whole
+        # even when every small cell sees a single edge (one edge alone cannot tell expansion from a shift)
+        roi = (slice(self.y0, self.y0 + self.rows * self.ch), slice(self.x0, self.x0 + self.cols * self.cw))
+        g_rate, g_se, g_n = self._fit(*(a[roi][None, None] for a in (ix, iy, it, valid)), self._xg, self._yg, dt)
+        min_n = 0.5 * self.ch * self.cw
+        ok = (n >= min_n) & (se <= self.max_se_per_s)
+        rate = np.where(ok, rate, np.nan)
+        if self._ema is not None:
+            both = ok & np.isfinite(self._ema)
+            rate = np.where(both, (1.0 - self.smooth) * rate + self.smooth * self._ema, rate)
+        self._ema = rate
+        g_ok = bool(g_n[0, 0] >= 2 * min_n and g_se[0, 0] <= self.max_se_per_s)
+        g_val = float(g_rate[0, 0]) if g_ok else math.nan
+        if g_ok and self._g_ema is not None and math.isfinite(self._g_ema):
+            g_val = (1.0 - self.smooth) * g_val + self.smooth * self._g_ema
+        self._g_ema = g_val
+        out.cells, out.dt_s = rate, dt
+        out.texture = float(ok.mean()) if not g_ok else max(float(ok.mean()), 0.5)
+        best, x_frac = -math.inf, 0.5
+        if ok.any():
+            k = int(np.nanargmax(rate))
+            best = float(rate.flat[k])
+            x_frac = (self.x0 + (k % self.cols + 0.5) * self.cw) / self.w
+        if g_ok and g_val > best:
+            best, x_frac = g_val, 0.5
+        if best > -math.inf:
+            if best >= self.min_rate:
+                out.rate, out.ttc_s, out.x_frac = best, 1.0 / best, x_frac
+            out.score = float(np.clip(max(best, 0.0) * self.gain, 0.0, 1.0))
+        out.latency_ms = 1000.0 * (time.perf_counter() - t0)
+        return out
+
+    @staticmethod
+    def _fit(IX, IY, IT, W, xl, yl, dt):
+        """Weighted least squares of brightness constancy with a similarity motion, for a batch of cells.
+        Returns (expansion rate 1/s, its standard error 1/s, weighted pixel count), each (rows, cols)."""
+        g = np.stack([IX, IY, IX * xl + IY * yl, IY * xl - IX * yl], axis=-1)  # (r, c, ch, cw, 4)
+        gw = g * W[..., None]
+        M = np.einsum("rcyxi,rcyxj->rcij", gw, g) + 1e-3 * np.eye(4, dtype=np.float32)
+        rhs = -np.einsum("rcyxi,rcyx->rci", gw, IT)
+        n = W.sum(axis=(2, 3))
+        M_inv = np.linalg.inv(M)
+        p = np.einsum("rcij,rcj->rci", M_inv, rhs)
+        resid = IT + np.einsum("rcyxi,rci->rcyx", g, p)
+        # at least 1 grey level of noise: a perfectly flat patch (a blank wall) is unmeasurable, not "certain"
+        sigma2 = np.maximum((W * resid ** 2).sum(axis=(2, 3)) / np.maximum(n - 4.0, 1.0), 1.0)
+        se = np.sqrt(np.maximum(sigma2 * M_inv[..., 2, 2], 0.0)) / dt
+        return p[..., 2] / dt, se, n

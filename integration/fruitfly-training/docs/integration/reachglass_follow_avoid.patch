@@ -0,0 +1,66 @@
+"""Following with obstacles in the way (follow.avoid), for tests/test_follow_avoid.py and the simulator:
+
+    python -m reachglass sim --scenario doorway --headless --record doorway.mp4 --seconds 45
+
+Each returns (world, drone_xy, drone_heading) like runner.demo_scenario; no query is sent, so the mission
+takes off and follows. The drone follows at 2.0 m, so low furniture (chairs, tables) is flown over: what
+can hit it at that height is tall furniture, a door header (2.03 m) and walls. Tall things here are drawn
+with texture where real ones have it (books, a printed carton) and flat where real ones are flat (walls).
+"""
+
+from __future__ import annotations
+
+from .person_model import SimPerson
+from .world import Box, PersonScript, World
+
+WALL = (175, 180, 185)
+FRAME = (60, 70, 80)
+
+
+def _world(boxes, script, size=(9.0, 7.0)) -> World:
+    w = World(size_x=size[0], size_y=size[1], boxes=boxes)
+    w.person = SimPerson(*script.at(0.0))
+    w.person_script = script
+    return w
+
+
+def table_pass():
+    """The user walks past a dining table and chairs and around the end of a tall bookcase (1.95 m, books):
+    the straight line from the drone to the user cuts the bookcase's corner. The table and chairs are
+    below flight height: the drone must fly over them without braking."""
+    boxes = [
+        Box((3.2, 1.0, 0.0), (4.6, 2.0, 0.75), (60, 90, 120), "dining table"),
+        Box((3.5, 2.1, 0.0), (3.9, 2.5, 0.9), (70, 120, 160), "chair"),
+        Box((5.0, 2.4, 0.0), (5.4, 4.6, 1.95), (40, 80, 130), "", texture_m=0.12),  # bookcase across the room
+    ]
+    script = PersonScript([(0.0, 2.4, 3.2, 0.0), (8.0, 2.4, 3.2, 0.0), (16.0, 4.4, 4.9, 40.0), (19.0, 5.2, 5.3, 20.0),
+                           (24.0, 6.4, 5.2, -20.0), (30.0, 6.9, 3.6, -80.0), (60.0, 6.9, 3.6, -80.0)])
+    return _world(boxes, script), (1.2, 3.0), 0.0
+
+
+def doorway():
+    """A wall across the room with a 0.9 m door; its header is at 2.03 m, just above the drone's 2.0 m. The user
+    walks through and on into the next room. Without braking the drone flies into the header / wall."""
+    boxes = [
+        Box((4.5, 0.0, 0.0), (4.6, 3.0, 2.6), WALL, ""),
+        Box((4.5, 3.9, 0.0), (4.6, 7.0, 2.6), WALL, ""),
+        Box((4.5, 3.0, 2.03), (4.6, 3.9, 2.6), WALL, ""),  # header
+        Box((4.45, 2.92, 0.0), (4.65, 3.0, 2.1), FRAME, ""),  # door frame (jambs + head)
+        Box((4.45, 3.9, 0.0), (4.65, 3.98, 2.1), FRAME, ""),
+        Box((4.45, 3.0, 2.03), (4.65, 3.9, 2.1), FRAME, ""),
+    ]
+    script = PersonScript([(0.0, 2.2, 3.45, 0.0), (8.0, 2.2, 3.45, 0.0), (19.0, 5.6, 3.45, 0.0), (24.0, 7.2, 3.45, 0.0),
+                           (60.0, 7.2, 3.45, 0.0)])
+    return _world(boxes, script), (1.0, 3.45), 0.0
+
+
+def box_in_path():
+    """A tall carton (wardrobe box, 1.95 m, printed) stands in the path; the user steps around it on the left
+    and walks on. The drone's straight path to the user goes through the box."""
+    boxes = [Box((4.6, 2.6, 0.0), (5.2, 3.6, 1.95), (70, 130, 170), "", texture_m=0.15)]
+    script = PersonScript([(0.0, 2.6, 3.1, 0.0), (8.0, 2.6, 3.1, 0.0), (13.0, 4.0, 3.1, 0.0), (17.0, 4.8, 4.2, 60.0),
+                           (22.0, 6.2, 4.2, 0.0), (26.0, 7.2, 3.2, -45.0), (60.0, 7.2, 3.2, -45.0)])
+    return _world(boxes, script), (1.4, 3.1), 0.0
+
+
+SCENARIOS = {"table_pass": table_pass, "doorway": doorway, "box_in_path": box_in_path}

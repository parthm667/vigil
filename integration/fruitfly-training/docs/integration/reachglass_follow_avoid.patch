+++ b/reachglass/types.py
@@ -173,6 +173,26 @@ class TargetObs(ObjectObs):
     confirmed: bool = False  # passed the target lock's confirmation rule
 
 
+@dataclass
+class LoomingObs:
+    """Expansion of the forward view (detect/looming.py): something ahead is getting closer.
+
+    rate = 1 / time-to-contact of the fastest-looming patch that has enough texture (1/s, after smoothing);
+    a surface at distance Z approached at speed V looms at V / Z. The locked person's box is excluded.
+    """
+
+    t: float
+    rate: float = 0.0  # 1/s, 0 = nothing looming (or nothing textured enough to tell)
+    ttc_s: float | None = None  # 1 / rate when something looms, else None
+    score: float = 0.0  # 0..1 looming strength (like the fly's LPLC2 channel)
+    x_frac: float = 0.5  # where the looming patch is, 0 = left edge, 1 = right edge of the image
+    texture: float = 0.0  # fraction of forward cells with enough texture to measure (0 = blind, e.g. a blank wall)
+    cells: np.ndarray | None = None  # (rows, cols) rate per cell, nan = not measurable
+    roi: tuple[float, float, float, float] = (0.0, 0.0, 1.0, 1.0)  # measured region, fractions of the image
+    dt_s: float = 0.0  # time between the two frames compared
+    latency_ms: float = 0.0
+
+
